# ============================================================
# MÔI TRƯỜNG ỨNG DỤNG


# ============================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Tên ứng dụng (hiển thị trong email và Swagger)
APP_NAME=Hệ thống Quản lý Lao động

# ============================================================
# SAMPLE DATA CHO FRONTEND (CHỈ DEVELOPMENT)
# ============================================================
# Local development only: migrations, reference catalogs and demo records are
# upserted automatically when the backend starts. Production never runs this seed.
SEED_SAMPLE_DATA=true
SEED_ADMIN_USERNAME=admin_demo
SEED_ADMIN_PASSWORD=change-me-local-only
SEED_ADMIN_EMAIL=admin.demo@example.com
# Số doanh nghiệp và tài khoản doanh nghiệp mẫu (tối đa 100).
SEED_PAGINATION_RECORDS=30
# Mật khẩu chung của các tài khoản doanh nghiệp mẫu (username là mã số thuế 099...).
SEED_ENTERPRISE_PASSWORD=change-me-local-only

# Tạo admin ban đầu ở mọi môi trường chỉ khi chủ động bật.
# Tắt lại ngay sau khi tài khoản đã được tạo.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=Quản trị viên

# ============================================================
# CƠ SỞ DỮ LIỆU POSTGRESQL
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=12345678
DB_NAME=quan_ly_lao_dong
# Database riêng cho E2E; không dùng chung database development.
TEST_DB_NAME=quan_ly_lao_dong_test
# Tự chạy các migration còn thiếu khi BE khởi động.
# Production có thể đặt false và chạy `npm run migration:run` khi deploy.
DB_MIGRATIONS_RUN=true
# Bật tạm khi cần debug SQL; để false giúp log seed gọn hơn.
DB_LOGGING=false

# ============================================================
# JWT AUTHENTICATION
# ============================================================
# 🔑 QUAN TRỌNG: Thay bằng secret ngẫu nhiên dài tối thiểu 32 ký tự!
JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# ============================================================
# CẤU HÌNH EMAIL (SMTP)
# ============================================================
# Ví dụ sử dụng Gmail:
# 1. Bật "2-Step Verification" trong tài khoản Google
# 2. Vào: Manage Google Account > Security > App passwords
# 3. Tạo App Password và điền vào MAIL_PASS bên dưới
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-smtp-user@example.com
MAIL_PASS=replace-with-smtp-app-password

# ============================================================
# CẤU HÌNH COOKIE AUTHENTICATION
# ============================================================
COOKIE_ACCESS_TOKEN_NAME=access_token
COOKIE_REFRESH_TOKEN_NAME=refresh_token
# Bỏ trống COOKIE_DOMAIN ở môi trường development (localhost)
COOKIE_DOMAIN=
# Bắt buộc true ở production (HTTPS), false ở development (HTTP localhost)
COOKIE_SECURE=false
# lax | strict | none (nếu chọn none, bắt buộc COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
COOKIE_PATH=/

# ============================================================
# CẤU HÌNH REDIS
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# LƯU TRỮ FILE TRÊN CLOUDFLARE R2
# ============================================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=your-public-image-r2-bucket-name
R2_PUBLIC_BASE_URL=https://your-public-bucket-domain.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

MAIL_LOGO_URL=cid:vna-group-logo
