# ============================================================
# MÔI TRƯỜNG ỨNG DỤNGThông tin đăng nhập tài khoản mẫu:


# ============================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Tên ứng dụng (hiển thị trong email và Swagger)
APP_NAME=Hệ thống Quản lý Lao động

# ============================================================
# SAMPLE DATA CHO FRONTEND (CHỈ DEVELOPMENT)
# ============================================================
SEED_SAMPLE_DATA=true
SEED_ADMIN_USERNAME=admin_demo
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_EMAIL=admin.demo@example.com

# ============================================================
# CƠ SỞ DỮ LIỆU POSTGRESQL
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=0936554618
DB_NAME=quan_ly_lao_dong
# Tự chạy các migration còn thiếu khi BE khởi động.
# Production có thể đặt false và chạy `npm run migration:run` khi deploy.
DB_MIGRATIONS_RUN=true

# ============================================================
# JWT AUTHENTICATION
# ============================================================
# 🔑 QUAN TRỌNG: Thay bằng secret ngẫu nhiên dài tối thiểu 32 ký tự!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-please
JWT_EXPIRES_IN=8h

# ============================================================
# CẤU HÌNH EMAIL (SMTP)
# ============================================================
# Ví dụ sử dụng Gmail:
# 1. Bật "2-Step Verification" trong tài khoản Google
# 2. Vào: Manage Google Account > Security > App passwords
# 3. Tạo App Password và điền vào MAIL_PASS bên dưới
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=testmail@gmail.com
MAIL_PASS=xlzgvdahdpxhqspj

# ============================================================
# CẤU HÌNH COOKIE AUTHENTICATION
# ============================================================
COOKIE_ACCESS_TOKEN_NAME=access_token
COOKIE_REFRESH_TOKEN_NAME=refresh_token
# Bỏ trống COOKIE_DOMAIN ở môi trường development (localhost)
COOKIE_DOMAIN=
# Bắt buộc true ở production (HTTPS), false ở development (HTTP localhost)
COOKIE_SECURE=false
# lax | strict | none (nếu chọn none, bắt buộc COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
COOKIE_PATH=/

# ============================================================
# CẤU HÌNH REDIS
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
